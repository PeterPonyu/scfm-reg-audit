\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces TF-disjoint supervised probe. (A) Confound-adjusted test correlation per family on 135 held-out TFs; labels give the gene-label permutation $q_M$ and, for each FM family, paired sign-flip $q_{\mathrm  {flip}}$ against co-expression. Green rows are supported against the baseline at $q_{\mathrm  {flip}}<0.05$ (UCE $0.0325$; random-init floor $0.0300$). (B) Recovery across confound subsets. (C) Edge-only primary arm versus the all-feature sensitivity arm. (D) Across-TFmean, median, and one standard deviation of adjusted recovery.}}{15}{figure.caption.13}\protected@file@percent }
\newlabel{fig:probe}{{10}{15}{TF-disjoint supervised probe. (A) Confound-adjusted test correlation per family on 135 held-out TFs; labels give the gene-label permutation $q_M$ and, for each FM family, paired sign-flip $q_{\mathrm {flip}}$ against co-expression. Green rows are supported against the baseline at $q_{\mathrm {flip}}<0.05$ (UCE $0.0325$; random-init floor $0.0300$). (B) Recovery across confound subsets. (C) Edge-only primary arm versus the all-feature sensitivity arm. (D) Across-TFmean, median, and one standard deviation of adjusted recovery}{figure.caption.13}{}}
